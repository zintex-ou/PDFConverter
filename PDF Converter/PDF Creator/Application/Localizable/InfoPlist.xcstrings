    "NSCameraUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "value": "This app requires access to the camera to scan and create images into PDF documents.",
            "state": "translated"
          }
        },
        "de": {
          "stringUnit": {
            "value": "Diese App benötigt Zugriff auf die Kamera, um Bilder zu scannen und in PDF-Dokumenten zu erstellen.",
            "state": "translated"
          }
        },
        "es": {
          "stringUnit": {
            "value": "Esta aplicación requiere acceso a la cámara para escanear y crear imágenes en documentos PDF.",
            "state": "translated"
          }
        },
        "fr": {
          "stringUnit": {
            "value": "Cette application nécessite l'accès à l'appareil photo pour numériser et créer des images dans des documents PDF.",
            "state": "translated"
          }
        },
        "it": {
          "stringUnit": {
            "value": "Questa app richiede l'accesso alla fotocamera per scansionare e creare immagini in documenti PDF.",
            "state": "translated"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "value": "Este aplicativo requer acesso à câmera para digitalizar e criar imagens em documentos PDF.",
            "state": "translated"
          }
        },
